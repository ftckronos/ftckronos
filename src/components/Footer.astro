---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__brand">
      {site.name} · Team #{site.teamNumber}
    </p>
    <p class="footer__meta">
      {site.location}
    </p>
    <p class="footer__copy">© {year} FTC Kronos. Season {site.season}.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 0;
    margin-top: 2rem;
  }

  .footer__inner {
    text-align: center;
  }

  .footer__brand {
    margin: 0 0 0.35rem;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .footer__meta,
  .footer__copy {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .footer__meta {
    margin-bottom: 0.5rem;
  }
</style>
