---
interface Props {
  name: string;
  role: string;
}

const { name, role } = Astro.props;
---

<article class="team-card">
  <h3>{name}</h3>
  <p>{role}</p>
</article>

<style>
  .team-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
  }

  .team-card h3 {
    margin-bottom: 0.25rem;
  }

  .team-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--accent);
  }
</style>
