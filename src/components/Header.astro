---
import { site } from '../data/site';
import { withBase } from '../utils/url';

const nav = [
  { path: '/#about', label: 'About' },
  { path: '/#mission', label: 'Mission' },
  { path: '/#team', label: 'Team' },
  { path: '/#subteams', label: 'Sub-teams' },
  { path: '/#ftc', label: 'FTC' },
  { path: '/outreach', label: 'Outreach' },
  { path: '/#awards', label: 'Awards' },
  { path: '/#join', label: 'Join' },
  { path: '/#contact', label: 'Contact' },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={withBase('/')}>
      <span class="header__name">{site.name}</span>
      <span class="header__num">#{site.teamNumber}</span>
    </a>
    <nav class="header__nav" aria-label="Main">
      {nav.map((item) => (
        <a href={withBase(item.path)}>{item.label}</a>
      ))}
    </nav>
    <details class="header__menu">
      <summary aria-label="Open menu">Menu</summary>
      <nav class="header__dropdown" aria-label="Mobile">
        {nav.map((item) => (
          <a href={withBase(item.path)}>{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(12, 12, 14, 0.92);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }

  .header__brand {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    color: var(--text);
    text-decoration: none;
    line-height: 1.2;
  }

  .header__brand:hover {
    color: var(--text);
  }

  .header__name {
    font-weight: 600;
    font-size: 1rem;
  }

  .header__num {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 500;
  }

  .header__nav {
    display: none;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    justify-content: flex-end;
  }

  .header__nav a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .header__nav a:hover {
    color: var(--text);
  }

  .header__menu {
    position: relative;
  }

  .header__menu summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .header__menu summary::-webkit-details-marker {
    display: none;
  }

  .header__dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    display: flex;
    flex-direction: column;
    min-width: 11rem;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .header__dropdown a {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 4px;
  }

  .header__dropdown a:hover {
    background: var(--bg);
    color: var(--text);
  }

  @media (min-width: 900px) {
    .header__nav {
      display: flex;
    }

    .header__menu {
      display: none;
    }
  }
</style>
