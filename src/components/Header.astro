---
import { site } from '../data/site';
import { withBase } from '../utils/url';

const pathname = Astro.url.pathname;

const nav = [
  { path: '/', label: 'Home' },
  { path: '/mission/', label: 'Mission' },
  { path: '/team/', label: 'Team' },
  { path: '/outreach/', label: 'Outreach' },
  { path: '/awards/', label: 'Awards' },
  { path: '/contact/', label: 'Contact' },
];

function isItemActive(itemPath: string) {
  const fullTarget = withBase(itemPath);
  const cleanPath = pathname.replace(/\/$/, '');
  const cleanTarget = fullTarget.replace(/\/$/, '');

  if (itemPath === '/') {
    return cleanPath === cleanTarget || cleanPath === '';
  }
  return cleanPath === cleanTarget || cleanPath.startsWith(`${cleanTarget}/`);
}
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href={withBase('/')}>
      <span class="header__name">{site.name}</span>
      <span class="header__num">#{site.teamNumber}</span>
    </a>
    <nav class="header__nav" aria-label="Main">
      {nav.map((item) => {
        const active = isItemActive(item.path);
        return (
          <a
            href={withBase(item.path)}
            class:list={[{ 'header__nav--active': active }]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
    <details class="header__menu">
      <summary aria-label="Open menu">Menu</summary>
      <nav class="header__dropdown" aria-label="Mobile">
        {nav.map((item) => {
          const active = isItemActive(item.path);
          return (
            <a
              href={withBase(item.path)}
              class:list={[{ 'header__nav--active': active }]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </details>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(12, 12, 14, 0.92);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(8px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }

  .header__brand {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    color: var(--text);
    text-decoration: none;
    line-height: 1.2;
  }

  .header__brand:hover {
    color: var(--text);
  }

  .header__name {
    font-weight: 600;
    font-size: 1rem;
  }

  .header__num {
    font-size: 0.75rem;
    color: var(--accent);
    font-weight: 500;
  }

  .header__nav {
    display: none;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    justify-content: flex-end;
  }

  .header__nav a {
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .header__nav a:hover,
  .header__nav a.header__nav--active {
    color: var(--text);
    font-weight: 500;
  }

  .header__menu {
    position: relative;
  }

  .header__menu summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .header__menu summary::-webkit-details-marker {
    display: none;
  }

  .header__dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    display: flex;
    flex-direction: column;
    min-width: 11rem;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .header__dropdown a {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 4px;
  }

  .header__dropdown a:hover,
  .header__dropdown a.header__nav--active {
    background: var(--bg);
    color: var(--text);
    font-weight: 500;
  }

  @media (min-width: 900px) {
    .header__nav {
      display: flex;
    }

    .header__menu {
      display: none;
    }
  }
</style>
