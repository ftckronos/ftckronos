---
interface Props {
  id: string;
  title: string;
  lead?: string;
  alt?: boolean;
}

const { id, title, lead, alt = false } = Astro.props;
---

<section id={id} class:list={['section', { 'section--alt': alt }]}>
  <div class="container">
    <h2>{title}</h2>
    {lead && <p class="section__lead">{lead}</p>}
    <slot />
  </div>
</section>
