---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';
---

<BaseLayout>
  <section id="home" class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">FIRST Tech Challenge · {site.season}</p>
      <h1>{site.name}</h1>
      <p class="hero__tagline">{site.tagline}</p>
    </div>
  </section>

  <Section id="about" title="About us" lead={`Founded in ${site.foundedYear} · ${site.location}`}>
    {site.about.map((paragraph) => <p>{paragraph}</p>)}
    <ul class="about-facts">
      <li>Team #{site.teamNumber}</li>
      <li>{site.location}</li>
      <li>Rookie season: {site.foundedYear}</li>
    </ul>
  </Section>
</BaseLayout>

<style>
  .hero {
    padding: 5rem 0 4.5rem;
    border-bottom: 1px solid var(--border);
  }

  .hero__inner {
    max-width: 40rem;
  }

  .hero__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero__tagline {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .about-facts {
    margin-top: 1.5rem;
    color: var(--text-muted);
  }
</style>
